# Vimarsh Text-to-SQL Server Configuration

# Port for the Express server (defaults to 3000)
PORT=3000

# Optional Server-Managed Gemini API Key (Development & AI Studio Preview Only)
# When set, enables server-managed key mode in development or preview environments.
# In production (NODE_ENV=production), server-managed key mode is disabled by default (fails closed)
# unless explicitly permitted via ALLOW_SERVER_MANAGED_KEY=true with an upstream authentication proxy.
# GEMINI_API_KEY=your_gemini_api_key_here

# Explicitly permit server-managed key mode in production (default: false)
# ALLOW_SERVER_MANAGED_KEY=false

# Trusted reverse proxy configuration (default: disabled / false)
# When deploying behind a trusted reverse proxy (e.g., Cloud Run, NGINX), set hop count (e.g. 1)
# or subnet descriptor (e.g. loopback). Untrusted or unconfigured proxies ignore X-Forwarded-For.
# TRUST_PROXY=1
